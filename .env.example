# Template for local env config. Copy to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ vars are public — they are inlined into the published game bundle.

# The game's shareable "play" link, used by the Web Share fallback.
NEXT_PUBLIC_GAME_URL=https://fb.gg/play/YOUR_APP_ID
